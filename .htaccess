# DIAETA.BE - Apache Configuration
# Generated: October 12, 2025

# ==============================================================================
# REDIRECTS - Fix broken links and old bookmarks
# ==============================================================================

# Enable RewriteEngine for more complex redirects
RewriteEngine On

# Remove .html extension (clean URLs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)/?$ $1.html [L]

# Handle old URLs that might be indexed
# Redirect old dietitian pages to new structure
RewriteRule ^dietitian-(.*)$ /EN/dietitian%20dietician%20nutritionist%20$1 [R=301,L]
RewriteRule ^dieteticien-(.*)$ /diététicien-diététicienne-nutritionniste-$1 [R=301,L]

# Fix common 404 patterns and handle URL encoding
RewriteRule ^EN/dietitian-dietician-nutritionist-Ixelles/(.*)$ /EN/dietitian%20dietician%20nutritionist%20Ixelles/$1 [R=301,L,NE]
RewriteRule ^NL/dietist-(.*)$ /NL/dietist-voedingsdeskundige-$1 [R=301,L]

# Handle spaces in URLs (redirect non-encoded to encoded)
RewriteCond %{REQUEST_URI} ^(.*)\ (.*)$
RewriteRule . %1\%20%2 [R=301,L,NE]

# Fix common misspellings and variations
RewriteRule ^dieteticien/(.*)$ /diététicien-diététicienne-nutritionniste/$1 [R=301,L]
RewriteRule ^nutritionist/(.*)$ /EN/dietitian%20dietician%20nutritionist/$1 [R=301,L,NE]

# ==============================================================================
# URL ENCODING & CHARACTER HANDLING
# ==============================================================================

# Enable UTF-8 encoding
AddDefaultCharset UTF-8

# ==============================================================================
# SECURITY HEADERS
# ==============================================================================

# Prevent clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# Enable XSS protection
Header always set X-XSS-Protection "1; mode=block"

# Prevent MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# Referrer policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ==============================================================================
# PERFORMANCE OPTIMIZATION
# ==============================================================================

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML
  ExpiresByType text/html "access plus 1 day"
</IfModule>

# ==============================================================================
# ERROR DOCUMENTS
# ==============================================================================

ErrorDocument 404 /404.html
ErrorDocument 500 /500.html

# ==============================================================================
# FORCE HTTPS (Uncomment when SSL is configured)
# ==============================================================================

# RewriteEngine On
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# ==============================================================================
# PREVENT DIRECTORY LISTING
# ==============================================================================

Options -Indexes

# ==============================================================================
# PROTECT SENSITIVE FILES
# ==============================================================================

# Only block truly sensitive files
<FilesMatch "\.(htaccess|htpasswd|env|lock|git)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to configuration directories
<DirectoryMatch "^\.">
  Order allow,deny
  Deny from all
</DirectoryMatch>
