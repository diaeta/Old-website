# MINIMAL SAFE .htaccess for DIAETA.BE
# This version removes ALL potentially problematic directives

# Basic rewrite engine (required for clean URLs)
RewriteEngine On

# Remove .html extension - SIMPLIFIED VERSION
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# ==============================================================================
# STEP 4: REDIRECT RULES (Fix 404 errors - Critical for SEO)
# ==============================================================================

# Fix doubled language prefixes (DE/DE/, EN/EN/, NL/NL/)
RewriteRule ^DE/DE/(.*)$ /DE/$1 [R=301,L]
RewriteRule ^EN/EN/(.*)$ /EN/$1 [R=301,L]
RewriteRule ^NL/NL/(.*)$ /NL/$1 [R=301,L]

# Strip trailing spaces from URLs (encoded as %20)
RewriteCond %{REQUEST_URI} ^(.*?)(%20)+$
RewriteRule ^(.*)$ %1 [R=301,L]

# Fix wrong English filename patterns - redirect root-level only to correct French names
RewriteRule ^terms\.html$ /conditions-generales.html [R=301,L]
RewriteRule ^legal\.html$ /mentions-legales.html [R=301,L]
RewriteRule ^privacy-policy\.html$ /politique-de-confidentialite.html [R=301,L]
RewriteRule ^cookie-policy\.html$ /politique-cookies.html [R=301,L]
RewriteRule ^terms-conditions\.html$ /conditions-generales.html [R=301,L]
RewriteRule ^legal-notice\.html$ /mentions-legales.html [R=301,L]

# Fix French page names in EN/DE directories (redirect to correct English/German names)
RewriteRule ^EN/mentions-legales\.html$ /EN/legal.html [R=301,L]
RewriteRule ^DE/mentions-legales\.html$ /DE/legal.html [R=301,L]

# Fix missing language prefix for German pages
RewriteRule ^Ernährungsberater-Diätassistent-Ernährungswissenschaftler/(.*)$ /DE/Ernährungsberater-Diätassistent-Ernährungswissenschaftler/$1 [R=301,L]
RewriteRule ^Nutrigenomik-Nutrigenetik/(.*)$ /DE/Nutrigenomik-Nutrigenetik/$1 [R=301,L]
RewriteRule ^Termin\.html$ /DE/Ernährungsberater-Diätassistent-Ernährungswissenschaftler/Termin.html [R=301,L]
RewriteRule ^DE/Termin\.html$ /DE/Ernährungsberater-Diätassistent-Ernährungswissenschaftler/Termin.html [R=301,L]

# Fix PDF locations
RewriteRule ^DE/Genetischer-Bericht-De\.pdf$ /DE/Nutrigenomik-Nutrigenetik/Genetischer-Bericht-De.pdf [R=301,L]
RewriteRule ^NL/nutrigenomica-nutrigenetica/Rapport%20genetische%20test%20NL\.pdf$ /NL/nutrigenomica-nutrigenetica/Genetisch-rapport-NL.pdf [R=301,L,NE]

# Fix /home.html in subdirectories - redirect to language home page
RewriteRule ^([A-Z]{2})/[^/]+/[^/]+/home\.html$ /$1/home.html [R=301,L]
RewriteRule ^([A-Z]{2})/[^/]+/home\.html$ /$1/home.html [R=301,L]
RewriteRule ^([A-Z]{2})/index\.html$ /$1/home.html [R=301,L,NC]

# Fix missing /index.html and /nutrigenomics.html for EN and NL
RewriteRule ^EN/index\.html$ /EN/home.html [R=301,L]
RewriteRule ^EN/nutrigenomics\.html$ /EN/nutrigenomics%20nutrigenetics/genetic%20test.html [R=301,L,NE]
RewriteRule ^NL/nutrigenomics\.html$ /NL/nutrigenomica-nutrigenetica/genetische-test.html [R=301,L]

# Fix general voorwaarden (NL)
RewriteRule ^algemene-voorwaarden\.html$ /NL/algemene-voorwaarden.html [R=301,L]

# Handle old dietitian URL patterns (from Google Search Console)
RewriteRule ^dietitian-(.*)$ /EN/dietitian%20dietician%20nutritionist%20$1 [R=301,L,NE]
RewriteRule ^dieteticien-(.*)$ /diététicien-diététicienne-nutritionniste-$1 [R=301,L,NE]

# Fix common 404 patterns
RewriteRule ^EN/dietitian-dietician-nutritionist-Ixelles/(.*)$ /EN/dietitian%20dietician%20nutritionist%20Ixelles/$1 [R=301,L,NE]

# Fix case sensitivity for Appointment.html
RewriteRule ^EN/dietitian-dietician-nutritionist/Appointment\.html$ /EN/dietitian-dietician-nutritionist/appointment.html [R=301,L]

# Fix contact.html in wrong directory
RewriteRule ^EN/dietitian-dietician-nutritionist/contact\.html$ /EN/contact.html [R=301,L]

# Fix malformed URLs with repeated "voedingsdeskundige" (from old infinite loop bug)
# Only match if there are 2+ occurrences of "voedingsdeskundige-"
RewriteRule ^NL/dietist-voedingsdeskundige-(?:voedingsdeskundige-)+(.*)$ /NL/dietist-voedingsdeskundige-$1 [R=301,L]

# Only redirect if URL doesn't already contain dietist-voedingsdeskundige (prevent infinite loop)
RewriteRule ^NL/dietist-(?!voedingsdeskundige)(.*)$ /NL/dietist-voedingsdeskundige-$1 [R=301,L]

# Handle language variations
RewriteRule ^dieteticien/(.*)$ /diététicien-diététicienne-nutritionniste/$1 [R=301,L]
RewriteRule ^nutritionist/(.*)$ /EN/dietitian%20dietician%20nutritionist/$1 [R=301,L,NE]
RewriteRule ^nutrigenomics%20nutrigenetics/(.*)$ /EN/nutrigenomics%20nutrigenetics/$1 [R=301,L,NE]

# Only redirect if URL contains lowercase "diaeta" (not "Diaeta")
RewriteCond %{THE_REQUEST} /images/logos/diaeta.svg [NC]
RewriteCond %{REQUEST_URI} !^/images/logos/Diaeta.svg$
RewriteRule ^images/logos/diaeta.svg$ /images/logos/Diaeta.svg [R=301,L]
RewriteRule ^images/logos/diaeta.svg$ /images/logos/Diaeta.svg [R=301,L]

# Redirect index to language-specific home pages
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^home\.html$ / [R=301,L]

# ==============================================================================
# STEP 5: HTTPS & WWW NORMALIZATION
# ==============================================================================

# ==============================================================================
# URL ENCODING REDIRECTS (Fix accented character issues)
# ==============================================================================

# French pages with accented characters (URL-encoded %C3%A9 = é, %C3%A8 = è)
RewriteRule ^di%C3%A9t%C3%A9tique/(.*)$ /diététique/$1 [R=301,L,NE]
RewriteRule ^diab%C3%A8te\.html$ /diabète.html [R=301,L,NE]
RewriteRule ^di%C3%A9t%C3%A9ticien-di%C3%A9t%C3%A9ticienne-nutritionniste/(.*)$ /diététicien-diététicienne-nutritionniste/$1 [R=301,L,NE]

# German pages with special characters (URL-encoded %C3%A4 = ä, %C3%BC = ü)
RewriteRule ^DE/Ern%C3%A4hrungsberater-Di%C3%A4tassistent-Ern%C3%A4hrungswissenschaftler-und-Di%C3%A4tetik/(.*)$ /DE/Ernährungsberater-Diätassistent-Ernährungswissenschaftler-und-Diätetik/$1 [R=301,L,NE]
RewriteRule ^DE/Ern%C3%A4hrungsberater-Di%C3%A4tassistent-Ern%C3%A4hrungswissenschaftler/(.*)$ /DE/Ernährungsberater-Diätassistent-Ernährungswissenschaftler/$1 [R=301,L,NE]

# English pages with special characters in directory names
RewriteRule ^EN/dietitian%20dietician%20nutritionist%20(.*)$ /EN/dietitian%20dietician%20nutritionist%20$1 [R=301,L,NE]


# Force HTTPS (Active - SSL is enabled)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force WWW version (choose one: www or non-www for consistency)
# Option 1: Force www (uncomment if you prefer www.diaeta.be)
# RewriteCond %{HTTP_HOST} ^diaeta\.be [NC]
# RewriteRule ^(.*)$ https://www.diaeta.be/$1 [L,R=301]

# Option 2: Force non-www (uncomment if you prefer diaeta.be)
# RewriteCond %{HTTP_HOST} ^www\.diaeta\.be [NC]
# RewriteRule ^(.*)$ https://diaeta.be/$1 [L,R=301]

# UTF-8 encoding
AddDefaultCharset UTF-8

# Basic error page
ErrorDocument 404 /404.html

# Prevent directory listing
Options -Indexes

# ==============================================================================
# STEP 1: BROWSER CACHING (SEO CRITICAL - Improves PageSpeed scores)
# ==============================================================================

<IfModule mod_expires.c>
  ExpiresActive On

  # Images (1 year cache - they rarely change)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

  # CSS and JavaScript (1 month - update occasionally)
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # Fonts (1 year - rarely change)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # HTML (shorter cache - content updates)
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ==============================================================================
# STEP 2: COMPRESSION (SEO CRITICAL - Reduces file sizes by 60-80%)
# ==============================================================================

<IfModule mod_deflate.c>
  # Enable compression for text-based files
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml

  # Don't compress images (already compressed)
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp)$ no-gzip dont-vary

  # Handle proxies properly (only if mod_headers is available)
  <IfModule mod_headers.c>
    Header append Vary User-Agent env=!dont-vary
  </IfModule>
</IfModule>

# Alternative compression method for older servers
<IfModule mod_gzip.c>
  mod_gzip_on Yes
  mod_gzip_dechunk Yes
  mod_gzip_item_include file \.(html?|txt|css|js|php|pl)$
  mod_gzip_item_include handler ^cgi-script$
  mod_gzip_item_include mime ^text/.*
  mod_gzip_item_include mime ^application/x-javascript.*
  mod_gzip_item_exclude mime ^image/.*
  mod_gzip_item_exclude rspheader ^Content-Encoding:.*gzip.*
</IfModule>

# ==============================================================================
# STEP 3: SECURITY HEADERS (SEO Trust Signals - Google values secure sites)
# ==============================================================================

<IfModule mod_headers.c>
  # Prevent clickjacking attacks
  Header always set X-Frame-Options "SAMEORIGIN"

  # Enable XSS protection in older browsers
  Header always set X-XSS-Protection "1; mode=block"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Control referrer information
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Content Security Policy (allows necessary external resources)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.google-analytics.com https://www.googletagmanager.com https://www.google.com https://www.gstatic.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com https://r2cdn.perplexity.ai data:; img-src 'self' data: https: http:; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://cdn.jsdelivr.net; frame-src 'self' https://www.doctoranytime.be https://www.google.com;"

  # Permissions Policy (replaces Feature-Policy)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
# Redirect subdirectory privacy pages to main privacy page
RewriteRule ^EN/dietitian%20dietician%20nutritionist%20[^/]+/privacy\.html$ /EN/privacy.html [R=301,L,NE]
RewriteRule ^EN/nutrigenomics%20nutrigenetics/privacy\.html$ /EN/privacy.html [R=301,L,NE]
RewriteRule ^DE/[^/]+/privacy\.html$ /DE/privacy.html [R=301,L]
RewriteRule ^NL/[^/]+/privacy\.html$ /NL/privacy.html [R=301,L]
