{
  "name": "diaeta-website",
  "version": "1.0.0",
  "description": "Diaeta.be nutritionist website",
  "scripts": {
    "start": "npx http-server . -p 3000 -o",
    "dev": "npx http-server . -p 3000 -o",
    "build:css": "postcss css/style.css -o css/style.min.css",
    "watch:css": "postcss css/style.css -o css/style-min.css --watch",
    "serve": "npx http-server . -p 3000",
    "optimize:images": "imagemin images_backup/**/* --out-dir=images --plugin=jpegtran --plugin=pngquant --plugin=webp"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^5.0.0",
    "cheerio": "^1.1.2",
    "css-loader": "^6.8.1",
    "cssnano": "^6.0.1",
    "imagemin-cli": "^8.0.0",
    "imagemin-jpegtran": "^8.0.0",
    "imagemin-pngquant": "^10.0.0",
    "imagemin-webp": "^8.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.24",
    "postcss-cli": "^10.1.0",
    "postcss-loader": "^7.3.2",
    "postcss-url": "^10.1.3",
    "webpack": "^5.85.1",
    "webpack-cli": "^5.1.3",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.2",
    "clean-html": "^2.0.1",
    "glob": "^11.0.3",
    "playwright": "^1.56.0"
  }
}
