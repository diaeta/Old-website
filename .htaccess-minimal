# MINIMAL SAFE .htaccess for DIAETA.BE
# This version removes ALL potentially problematic directives

# Basic rewrite engine (required for clean URLs)
RewriteEngine On

# Remove .html extension - SIMPLIFIED VERSION
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L]

# UTF-8 encoding
AddDefaultCharset UTF-8

# Basic error page
ErrorDocument 404 /404.html

# Prevent directory listing
Options -Indexes